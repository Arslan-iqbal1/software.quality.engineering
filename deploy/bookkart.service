# BookKart — systemd service unit (VPS route, see DEPLOY.md).
# Install:  sudo cp deploy/bookkart.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now bookkart
# Logs:     journalctl -u bookkart -f
[Unit]
Description=BookKart online bookstore
After=network.target

[Service]
Type=simple
User=bookkart
WorkingDirectory=/opt/bookkart
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3000
# Point the database at a persistent data directory:
Environment=BOOKKART_DB=/var/lib/bookkart/bookkart.db
# Secrets can also live in /opt/bookkart/.env (loaded automatically).
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
