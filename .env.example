# BookKart configuration — copy this file to ".env" and fill in your values.
# (.env is git-ignored: never commit real secrets.)
# Real environment variables always override .env values.

# Port the store listens on (hosts like Render set this automatically).
PORT=3000

# Where the SQLite database file lives (default: data/bookkart.db).
# BOOKKART_DB=/var/lib/bookkart/bookkart.db

# REQUIRED for a public store: protects /admin.html order management.
# Pick a long, private value — you will type it into the admin page prompt.
BOOKKART_ADMIN_KEY=change-me-to-a-long-private-key

# Get a phone push on every new order — pick ONE (or more) channels:

# Option 1 — ntfy.sh (free, no account): install the ntfy app, subscribe
# to a private topic name you invent, and put that name here.
BOOKKART_NTFY_TOPIC=

# Option 2 — Telegram: create a bot with @BotFather, then fill both.
BOOKKART_TELEGRAM_TOKEN=
BOOKKART_TELEGRAM_CHAT_ID=

# Option 3 — any webhook URL (receives a JSON POST per order).
BOOKKART_WEBHOOK_URL=
